# =============================================================
# Ambiente
# =============================================================
NODE_ENV=production
PORT=3333

# =============================================================
# Banco de dados
# Supabase: Settings > Database > Connection string (URI)
# =============================================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1

# =============================================================
# Autenticação JWT
# Gerar com: openssl rand -hex 32
# =============================================================
JWT_SECRET=sua_chave_secreta_com_pelo_menos_32_caracteres
JWT_EXPIRES_IN=8h

# =============================================================
# Storage de imagens
# Opções: 's3' (AWS) | 'r2' (Cloudflare R2)
# =============================================================
STORAGE_PROVIDER=r2

# --- Cloudflare R2 (recomendado — egress gratuito) ---
# Account ID: Cloudflare Dashboard > R2 > Overview
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com

# Credenciais: R2 > Manage R2 API Tokens > Create API Token
AWS_ACCESS_KEY_ID=sua_r2_access_key_id
AWS_SECRET_ACCESS_KEY=sua_r2_secret_access_key
AWS_REGION=auto
AWS_BUCKET_NAME=nome-do-seu-bucket

# Domínio PÚBLICO de leitura do bucket — NÃO é o R2_ENDPOINT acima.
# O R2_ENDPOINT é a API S3 e exige assinatura SigV4: usá-lo como URL de imagem
# devolve 400 InvalidArgument em qualquer <img>. Pegue este valor em
# R2 > seu bucket > Settings > Public Development URL (r2.dev) ou configure um
# domínio próprio. Sem esta variável as imagens são servidas por
# GET /img/:imageId, que redireciona para uma URL assinada (funciona, mas passa
# pela API em vez de ir direto pelo CDN).
R2_PUBLIC_URL=https://imagens.seu-dominio.com

# --- AWS S3 (alternativa) ---
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=
# (sem R2_ENDPOINT para S3)

# =============================================================
# CORS
# Domínio do frontend em produção
# =============================================================
CORS_ORIGIN=https://seu-frontend.vercel.app
