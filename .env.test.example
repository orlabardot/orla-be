# =============================================================
# Ambiente de TESTE — copie para .env.test
#
# A suíte de testes CRIA E APAGA DADOS (as factories truncam tabelas).
# Aponte isto para um banco local e descartável, NUNCA para produção nem para
# um banco compartilhado. O docker-compose.yml deste repositório já sobe um
# Postgres adequado em localhost:5433 (`docker compose up -d`).
# =============================================================
NODE_ENV=test
PORT=3334

# Banco local do docker-compose.yml (usuário/senha/base definidos lá mesmo).
DATABASE_URL=postgresql://orla:orla@localhost:5433/orla_db?schema=public

# Qualquer valor com 32+ caracteres serve — não reaproveite o segredo de produção.
# Gerar com: openssl rand -hex 32
JWT_SECRET=segredo_de_teste_com_pelo_menos_32_caracteres
JWT_EXPIRES_IN=1h

# Storage não é exercitado de verdade nos testes: valores fictícios bastam.
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_BUCKET_NAME=orla-test
